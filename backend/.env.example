# Copy to .env and fill in. Never commit the real .env file.

# Postgres (matches docker-compose service defaults)
DATABASE_URL="postgresql://tutor_user:tutor_pass@localhost:5432/math_tutor?schema=public"

# Backend server
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"

# Grok AI (leave GROK_API_KEY blank to run with the built-in mock provider)
GROK_API_KEY=
GROK_LLM_MODEL=grok-4.5
# Realtime speech-to-speech voice agent (wss://api.x.ai/v1/realtime)
GROK_VOICE_MODEL=grok-voice-latest
# One of: eve (default), ara, rex, sal, leo
GROK_VOICE_NAME=eve
# Illustrations shown alongside counting/arithmetic lessons
GROK_IMAGE_MODEL=grok-imagine-image-quality
